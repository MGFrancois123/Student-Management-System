
pipeline {
    agent any

    environment {
        IMAGE_NAME = 'studenthub:2.0'
        CONTAINER_NAME = 'devops-container'
        HOST_PORT = '8081'
    }

    stages {

        stage('Checkout') {
            steps {
                echo 'Retrieving project from GitHub...'
                checkout scm
            }
        }

        stage('Build') {
            steps {
                echo 'Building Docker image...'
                bat 'docker build -t %IMAGE_NAME% .'
            }
        }

        stage('Test') {
            steps {
                echo 'Checking index.html...'
                bat 'findstr /C:"StudentHub" index.html'
            }
        }

        stage('Deploy') {
            steps {
                echo 'Deploying StudentHub application...'

                bat 'docker rm -f %CONTAINER_NAME% 2>NUL || exit /b 0'

                bat 'docker run -d --restart unless-stopped -p %HOST_PORT%:80 --name %CONTAINER_NAME% %IMAGE_NAME%'

                echo 'Deployment completed!'
            }
        }
    }

    post {
        success {
            echo 'Deployment successful!'
            echo 'Open http://localhost:8081 to view StudentHub.'
        }

        failure {
            echo 'Deployment failed. Check Jenkins Console Output.'
        }

        always {
            echo 'Activity 17 pipeline execution completed.'
        }
    }
}
